---
import Icon from './Icon.astro';
import type { Locale } from '../lib/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const cards = zh ? [
  { icon: 'code', title: '模型与 Python 工具', body: '连接明确的模型协议，把业务函数注册为工具。用参数 Schema、输出约束和审批规则定义调用边界。', use: '工单查询、订单助手、业务操作', tag: 'MODELS / TOOLS', guide: 'models-tools' },
  { icon: 'layers', title: '工作流与多 Agent', body: '把已知依赖编成静态图，按需加入有界并行、Plan 或 Team。父子任务保留各自的结果与执行身份。', use: '分步诊断、路由分派、研究与复核', tag: 'WORKFLOW / PLAN / TEAM', guide: 'workflows' },
  { icon: 'restart', title: '持久会话与长期记忆', body: '用 Session 串起多轮任务，用版本化 Facts 保存已确认信息。显式选择召回和上下文策略。', use: '连续对话、客户偏好、跨轮任务', tag: 'SESSION / FACTS / CONTEXT', guide: 'sessions-memory' },
  { icon: 'book', title: '文档摄取与知识检索', body: '摄入文档、保存版本与来源，选择词法、向量或混合检索。让回答依据可以追溯，再验证实际效果。', use: '运维手册、产品问答、知识助手', tag: 'INGESTION / RAG / ARTIFACTS', guide: 'sessions-memory' },
  { icon: 'globe', title: '外部工具与工作资料', body: '按需接入 MCP、HTTP、固定 CLI、Workspace 与 Skills。宿主选择工具与范围，执行仍沿用审批和回执协议。', use: '复用服务、内部脚本、文件与操作说明', tag: 'MCP / HTTP / CLI / SKILLS', guide: 'integrations' },
  { icon: 'shield', title: '配置、交互与恢复', body: '固定组件版本与执行限制。分别处理审批、补充输入和未知效果，通过原记录观察并恢复任务。', use: '版本管理、运行排障、受控执行', tag: 'PROFILE / LIMITS / RECOVERY', guide: 'operations' },
] : [
  { icon: 'code', title: 'Models and Python tools', body: 'Connect an explicit model protocol and register business functions as tools. Define arguments, output constraints and approval rules.', use: 'Ticket lookups, order assistants, business actions', tag: 'MODELS / TOOLS', guide: 'models-tools' },
  { icon: 'layers', title: 'Workflows and teams', body: 'Express dependencies as static graphs. Add bounded parallelism, plans or teams. Parent and child tasks retain their own results and identities.', use: 'Stepwise diagnosis, routing, research and review', tag: 'WORKFLOW / PLAN / TEAM', guide: 'workflows' },
  { icon: 'restart', title: 'Durable conversations and memory', body: 'Link turns through sessions and retain confirmed information as versioned facts. Select recall and context policies explicitly.', use: 'Follow-up questions, preferences, multi-turn tasks', tag: 'SESSION / FACTS / CONTEXT', guide: 'sessions-memory' },
  { icon: 'book', title: 'Documents and retrieval', body: 'Ingest documents with versions and sources. Choose lexical, vector or hybrid retrieval, trace the evidence and evaluate actual results.', use: 'Runbooks, product questions, knowledge assistants', tag: 'INGESTION / RAG / ARTIFACTS', guide: 'sessions-memory' },
  { icon: 'globe', title: 'External tools and references', body: 'Opt into MCP, HTTP, fixed CLIs, workspaces and skills. The host selects tools and scope; approval and receipt protocols still apply.', use: 'Existing services, internal scripts, files and instructions', tag: 'MCP / HTTP / CLI / SKILLS', guide: 'integrations' },
  { icon: 'shield', title: 'Configuration, input and recovery', body: 'Pin components and execution limits. Handle approvals, user input and uncertain effects through their own controls, then observe and resume original tasks.', use: 'Version management, diagnosis, controlled execution', tag: 'PROFILE / LIMITS / RECOVERY', guide: 'operations' },
];
---
<section id="capabilities" class="capabilities section-pad container">
  <div class="section-heading"><div><div class="eyebrow"><span class="section-index">02 /</span> YOUR LOGIC. A CLEAR PATH.</div><h2>{zh ? '从一个业务工具，' : 'From one business tool.'}<br/><span class="muted">{zh ? '到完整的 Agent 应用。' : 'To a complete agent application.'}</span></h2></div><p>{zh ? '先解决一个具体任务，再加入对话、知识与协作。每项能力都有独立的配置、使用指南和恢复边界。' : 'Start with one concrete task. Add conversations, knowledge and collaboration as needed, with explicit configuration, guides and recovery boundaries.'}</p></div>
  <div class="capability-grid">
    {cards.map((card) => <a class="capability-card" href={`/${locale}/docs/${card.guide}/`}><div class="feature-top"><span class="feature-icon"><Icon name={card.icon} size={22}/></span><Icon name="arrow" class="card-arrow" size={19}/></div><h3>{card.title}</h3><p>{card.body}</p><p class="feature-use">{zh ? '适用：' : 'For: '}{card.use}</p><div class="feature-tags"><span>{card.tag}</span></div></a>)}
  </div>
  <div class="scale-band"><div><Icon name="layers" size={22}/><div><h3>{zh ? '本地起步，按需组合。' : 'Start locally. Compose as needed.'}</h3><p>{zh ? 'Local + SQLite 是低依赖起点。外部工具、远程存储与 Temporal 等扩展需显式配置，当前 Alpha 按各自实验性范围使用。' : 'Local + SQLite is the low-dependency starting point. External tools, remote stores and Temporal need explicit configuration within their experimental Alpha scope.'}</p></div></div><a class="text-link" href={`/${locale}/docs/overview/`}>{zh ? '查看完整能力与选型' : 'Explore capabilities & choices'}<Icon name="arrow" size={17}/></a></div>
</section>
<style>
  .capability-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .capability-card { display: flex; flex-direction: column; padding: 26px; min-width: 0; }
  .capability-card h3 { font-size: 20px; line-height: 1.5; }
  .capability-card p { font-size: 14px; line-height: 1.85; }
  .capability-card .feature-use { margin-top: 16px; color: #a9c6d5; font-size: 13px; }
  .feature-tags { padding-top: 24px; margin-top: auto; font-size: 11px; color: #91aebf; flex-wrap: wrap; }
  @media (max-width: 1000px) { .capability-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 580px) { .capability-grid { grid-template-columns: 1fr; } .capability-card { padding: 22px; } .capability-card h3 { font-size: 19px; } .feature-tags { padding-top: 18px; } }
</style>
