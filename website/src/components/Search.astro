---
import Icon from './Icon.astro';
import type { Locale } from '../lib/site';
interface Props { locale: Locale }
const { locale } = Astro.props; const zh = locale === 'zh';
---
<dialog class="search-dialog" aria-labelledby="search-title" data-locale={locale} data-pagefind-ignore>
  <div class="search-heading"><h2 id="search-title">{zh ? '搜索文档' : 'Search documentation'}</h2><button class="icon-button" data-search-close aria-label={zh ? '关闭搜索' : 'Close search'}><Icon name="close" /></button></div>
  <div id="search-ui">
    <form class="doc-search-form" role="search">
      <label class="sr-only" for="search-query">{zh ? '搜索文档' : 'Search documentation'}</label>
      <input id="search-query" class="doc-search-input" type="search" placeholder={zh ? '搜索安装、审批、恢复…' : 'Search installation, approvals, recovery…'} autocomplete="off" aria-describedby="search-status"/>
      <button class="doc-search-clear" type="button" data-search-clear>{zh ? '清空' : 'Clear'}</button>
    </form>
    <ol class="doc-search-results" aria-label={zh ? '搜索结果' : 'Search results'}></ol>
  </div><p id="search-status" class="search-message" role="status" aria-live="polite"></p>
  <div class="search-fallback" hidden><button class="button button-primary" data-search-retry>{zh ? '重试搜索' : 'Retry search'}<Icon name="restart" size={16}/></button><a class="button button-secondary" href={`/${locale}/docs/quickstart/`}>{zh ? '浏览文档' : 'Browse documentation'}<Icon name="book" size={16}/></a></div>
  <div class="search-footer"><span>Pagefind · {zh ? '本地静态搜索' : 'Static local search'}</span><span><kbd>esc</kbd> {zh ? '关闭' : 'close'}</span></div>
</dialog>
<script>
  import { createSearchBootstrap, withinDeadline, type SearchIndex } from '../lib/search-bootstrap';
  const dialog = document.querySelector<HTMLDialogElement>('.search-dialog');
  const message = document.querySelector<HTMLElement>('.search-message');
  const fallback = document.querySelector<HTMLElement>('.search-fallback');
  const retry = document.querySelector<HTMLButtonElement>('[data-search-retry]');
  const input = document.querySelector<HTMLInputElement>('#search-query');
  const results = document.querySelector<HTMLOListElement>('.doc-search-results');
  const zh = dialog?.dataset.locale === 'zh';
  const bootstrap = createSearchBootstrap((path) => import(/* @vite-ignore */ path), zh ? 'zh' : 'en');
  let index: SearchIndex | null = null;
  let loading = false;
  let request = 0;
  let debounce: ReturnType<typeof setTimeout>;
  let trigger: HTMLElement | null = null;
  function unavailable(error: unknown) {
    index = null;
    bootstrap.reset();
    results?.replaceChildren();
    if (message) message.textContent = zh ? '搜索暂时不可用。你可以重试，或从文档目录继续浏览。' : 'Search is temporarily unavailable. Try again, or continue browsing the documentation.';
    if (fallback) fallback.hidden = false;
    if (import.meta.env.DEV) console.warn('Search unavailable', error);
  }
  async function search() {
    const current = ++request;
    const query = input?.value.trim() ?? '';
    results?.replaceChildren();
    // Keep the loading status while remembering edits for the first ready query.
    if (!index) return;
    if (!query) { dialog?.removeAttribute('aria-busy'); if (message) message.textContent = zh ? '输入关键词，搜索当前语言的文档。' : 'Enter a keyword to search documentation in this language.'; return; }
    if (message) message.textContent = zh ? '搜索中…' : 'Searching…';
    dialog?.setAttribute('aria-busy', 'true');
    const active = index;
    try {
      const data = await withinDeadline((async () => {
        const response = await active.search(query);
        return Promise.all(response.results.map((result) => result.data()));
      })(), 12_000);
      if (current !== request) return;
      data.forEach((item) => {
        const url = new URL(item.url, window.location.origin);
        if (url.origin !== window.location.origin || !url.pathname.startsWith(`/${zh ? 'zh' : 'en'}/docs/`)) return;
        const row = document.createElement('li');
        const link = document.createElement('a'); link.href = url.href; link.textContent = item.meta.title || item.url;
        const excerpt = document.createElement('p'); excerpt.textContent = new DOMParser().parseFromString(item.excerpt, 'text/html').body.textContent;
        row.append(link, excerpt); results?.append(row);
      });
      const count = results?.children.length ?? 0;
      if (message) message.textContent = count ? (zh ? `找到 ${count} 条结果` : `${count} ${count === 1 ? 'result' : 'results'} found`) : (zh ? `没有找到“${query}”，请换一个关键词。` : `No results for “${query}”. Try another keyword.`);
    } catch (error) { if (current === request) unavailable(error); }
    finally { if (current === request) dialog?.removeAttribute('aria-busy'); }
  }
  async function loadSearch() {
    if (!dialog || index || loading) return;
    loading = true;
    ++request; clearTimeout(debounce);
    dialog.setAttribute('aria-busy', 'true');
    if (fallback) fallback.hidden = true;
    if (retry) retry.disabled = true;
    if (message) message.textContent = zh ? '正在加载搜索索引…' : 'Loading search index…';
    try {
      index = await bootstrap.load();
    } catch (error) { unavailable(error); }
    finally { loading = false; dialog.removeAttribute('aria-busy'); if (retry) retry.disabled = false; }
    if (index) { if (dialog.open) input?.focus(); await search(); }
  }
  async function openSearch() {
    if (!dialog || dialog.open) return;
    trigger = document.activeElement as HTMLElement;
    dialog.showModal();
    input?.focus();
    if (!index) await loadSearch();
  }
  input?.addEventListener('input', () => { ++request; clearTimeout(debounce); debounce = setTimeout(search, 200); });
  document.querySelector('.doc-search-form')?.addEventListener('submit', (event) => { event.preventDefault(); clearTimeout(debounce); search(); });
  document.querySelector('[data-search-clear]')?.addEventListener('click', () => { if (input) input.value = ''; clearTimeout(debounce); search(); input?.focus(); });
  retry?.addEventListener('click', loadSearch);
  const warmSearch = () => { void bootstrap.load().catch(() => {}); };
  document.querySelectorAll<HTMLElement>('[data-search-open]').forEach((button) => {
    button.addEventListener('click', openSearch);
    button.addEventListener('pointerenter', warmSearch, { once: true });
    button.addEventListener('focus', warmSearch, { once: true });
  });
  // Start cold network work before the first dialog click, without blocking page rendering.
  if ('requestIdleCallback' in window) window.requestIdleCallback(warmSearch, { timeout: 2_000 });
  else setTimeout(warmSearch, 1_000);
  document.querySelector('[data-search-close]')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (e) => { if (e.target === dialog) { const r = dialog.getBoundingClientRect(); if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) dialog.close(); } });
  dialog?.addEventListener('close', () => trigger?.focus());
  document.addEventListener('keydown', (e) => { if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); openSearch(); } });
</script>
