---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import HeroArt from './HeroArt.astro';
import ExecutionDemo from './ExecutionDemo.astro';
import Capabilities from './Capabilities.astro';
import { Code } from 'astro:components';
import { brand, guideSlugs, guideNames, guideDescriptions, featuredGuideSlugs, repository, repositoryInfo, type Locale } from '../lib/site';
interface Props { locale: Locale }
const { locale } = Astro.props; const zh = locale === 'zh';
const docs = `/${locale}/docs/`;
const description = zh ? `${brand.name}：${brand.meaning.zh}按需组合模型、工具、上下文与记忆，通过持久审批和恢复运行智能应用。` : `${brand.name}: ${brand.meaning.en} Compose models, tools and memory with durable approvals and recovery.`;
const installCode = `git clone ${repository}.git\ncd ralf-agent\ngit checkout ${repositoryInfo.ref}\npython3 -m venv .venv\nsource .venv/bin/activate\npython -m pip install -e .`;
const runCode = 'ralf --format text init ../my-agent\ncd ../my-agent\npython -m agent_app --ticket INC-001';
---
<Base locale={locale} title={`${brand.name} — ${brand.tagline[locale]}`} description={description}>
  <main id="main">
    <section class="hero container">
      <a class="hero-announcement" href={`${docs}concepts/`}><span class="status-dot"></span>{zh ? '开源 · PYTHON AGENT FRAMEWORK' : 'OPEN SOURCE · PYTHON AGENT FRAMEWORK'}<Icon name="arrow" size={14}/></a>
      <h1>{zh ? <>灵活构建智能体，<br/><span>可靠运行智能应用。</span></> : <>Build intelligent agents.<br/><span>Run them reliably.</span></>}</h1>
      <p class="hero-description">{zh ? <>{brand.meaning.zh}<br class="desktop-break"/>按需组合模型、工具与记忆，保存审批和回执，重启后继续原任务。</> : <>{brand.fullName}.<br class="desktop-break"/>Compose models, tools and memory. Keep approvals and receipts. Resume after a restart.</>}</p>
      <div class="hero-actions"><a class="button button-primary" href={`${docs}quickstart/`}>{zh ? '运行离线示例' : 'Run offline example'}<Icon name="arrow" size={18}/></a><a class="button button-secondary" href="#execution">{zh ? '体验审批与恢复' : 'Try the demo'}<Icon name="restart" size={17}/></a></div>
      <div class="hero-caption"><span>Python 3.11+</span><i></i><span>{zh ? '无需模型密钥' : 'No model key needed'}</span><i></i><span>{zh ? '本地 SQLite' : 'Local SQLite'}</span><i></i><span>Alpha</span></div>
      <HeroArt locale={locale}/>
    </section>

    <ExecutionDemo locale={locale}/>

    <Capabilities locale={locale}/>

    <section id="build" class="build-section section-pad container">
      <div class="build-copy">
        <div class="eyebrow"><span class="section-index">03 /</span> YOUR FIRST LOCAL RUN</div>
        <h2>{zh ? <>无需密钥，<br/><span class="muted">跑通第一个本地任务。</span></> : <>No model key.<br/><span class="muted">Your first local run.</span></>}</h2>
        <p>{zh ? '源码安装后，生成一个离线工单项目。固定 Provider 会提出待批操作，让你先理解执行协议，再接入自己的模型。' : 'Install from source and generate an offline ticket project. A fixed provider proposes an operation for approval, so you can learn the execution protocol before connecting a real model.'}</p>
        <ol class="build-steps"><li><span>01</span><div><strong>{zh ? '安装 SDK，生成项目' : 'Install the SDK and create a project'}</strong><p>{zh ? 'Python 3.11+ · 本地 SQLite' : 'Python 3.11+ · local SQLite'}</p></div></li><li><span>02</span><div><strong>{zh ? '检查并批准原操作' : 'Inspect and approve the operation'}</strong><p>inspect → approve</p></div></li><li><span>03</span><div><strong>{zh ? '恢复原 Run，检查完成状态' : 'Resume the run and inspect its result'}</strong><p>resume → succeeded</p></div></li></ol>
        <a class="text-link" href={`${docs}quickstart/`}>{zh ? '按完整教程继续审批与恢复' : 'Continue with the full approval & recovery tutorial'}<Icon name="arrow" size={17}/></a>
        <p class="code-note">{zh ? '首次运行预期停在 waiting_approval。这些命令用于安装与启动项目，完整教程在同一页包含安装、审批、恢复和结果检查。' : 'The first run should pause at waiting_approval. These commands install and start the project; the full tutorial covers installation, approval, recovery and result inspection on one page.'}</p>
      </div>
      <div class="sdk-code-panel">
        <div class="code-toolbar"><span><span class="tiny-square"></span>{zh ? '终端 · 离线工单' : 'Terminal · offline ticket'}</span><span>LOCAL / SQLITE</span></div>
        <div class="command-step"><h3>{zh ? '1. 从源码安装' : '1. Install from source'}</h3><Code code={installCode} lang="bash" theme="github-dark"/></div>
        <div class="command-step"><h3>{zh ? '2. 启动离线项目' : '2. Start the offline project'}</h3><Code code={runCode} lang="bash" theme="github-dark"/></div>
        <div class="code-panel-footer"><span class="status-dot"></span><span>{zh ? '预期状态' : 'Expected state'}: <code>waiting_approval</code></span></div>
        <details class="model-next"><summary>{zh ? '下一步：接入真实模型与 Python 工具' : 'Next: connect a real model and Python tools'}</summary><p>{zh ? '在模型与工具指南中查看完整 Python 示例。真实模型需配置凭据与型号，并产生供应商用量。' : 'Find the complete Python example in the models and tools guide. A real model requires credentials and model selection, and incurs provider usage.'}</p><a class="text-link" href={`${docs}models-tools/`}>{zh ? '阅读模型与工具指南' : 'Read the models & tools guide'}<Icon name="arrow" size={16}/></a></details>
      </div>
    </section>

    <section class="docs-section section-pad container"><div class="section-heading"><div><div class="eyebrow"><span class="section-index">04 /</span> FIND YOUR NEXT STEP</div><h2>{zh ? `从这里，走进 ${brand.name}。` : 'Your next step starts here.'}</h2></div><a class="text-link" href={`${docs}overview/`}>{zh ? '浏览全部文档' : 'Browse all documentation'}<Icon name="external" size={15}/></a></div><div class="guide-grid">{featuredGuideSlugs.map((slug, i) => <a class="guide-card" href={`${docs}${slug}/`}><div><span class="guide-number">0{i + 1}</span><Icon name="arrow" size={18}/></div><h3>{guideNames[locale][guideSlugs.indexOf(slug)]}</h3><p>{guideDescriptions[locale][slug]}</p></a>)}</div></section>

    <section class="closing-cta container"><div class="cta-orbit" aria-hidden="true"></div><div class="eyebrow">BUILT IN THE OPEN. READY FOR YOUR IDEAS.</div><h2>{zh ? '下一步，交给你来定义。' : 'Define what happens next.'}</h2><p>{zh ? '从第一个本地 Agent，开始你的执行路径。' : 'Start your execution path with a local agent.'}</p><div class="hero-actions"><a href={`${docs}quickstart/`} class="button button-primary">{zh ? '运行离线示例' : 'Run offline example'}<Icon name="arrow" size={17}/></a><a href={repository} class="button button-secondary"><Icon name="github" size={17}/>{zh ? '查看 GitHub' : 'View GitHub'}</a></div><span class="cta-status">ALPHA · APIS & DEPLOYMENT CONTINUE TO EVOLVE</span></section>
  </main>
</Base>
