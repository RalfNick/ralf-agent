---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import type { Locale } from '../lib/site';
interface Props { locale: Locale }
const { locale } = Astro.props; const zh = locale === 'zh';
---
<div class="hero-art" aria-label={zh ? '模型决策经过持久化执行内核与人工审批，恢复原任务的示意图' : 'Illustration: model decisions pass through a durable runtime and human approval to resume the original run'} role="img">
  <div class="art-grid"></div><div class="art-glow"></div>
  <svg class="art-paths" viewBox="0 0 1120 310" fill="none" aria-hidden="true"><defs><linearGradient id="path-glow"><stop stop-color="#1b3444"/><stop offset=".48" stop-color="#83e6ef"/><stop offset="1" stop-color="#1b3444"/></linearGradient></defs><path d="M50 220h120q24 0 24-24v-28q0-24 24-24h684q24 0 24 24v28q0 24 24 24h120" stroke="#1c3446"/><path d="M44 144h103q22 0 22-22v-28q0-22 22-22h180q22 0 22 22v28q0 22 22 22h288q22 0 22-22v-28q0-22 22-22h180q22 0 22 22v28q0 22 22 22h103" stroke="url(#path-glow)" stroke-width="1.5"/><path d="M249 259h145q22 0 22-22v-30q0-22 22-22h244q22 0 22 22v30q0 22 22 22h145" stroke="#1e3b4c" stroke-dasharray="4 5"/><circle cx="169" cy="110" r="3" fill="#82e4e9"/><circle cx="936" cy="210" r="3" fill="#82e4e9"/><circle cx="416" cy="237" r="3" fill="#3c7488"/><circle cx="704" cy="210" r="3" fill="#3c7488"/></svg>
  <div class="art-node art-node-input"><div class="art-node-label"><span class="node-icon"><Icon name="code" size={13}/></span> MODEL → DECISION <span class="node-small-dot"></span></div><div class="art-node-code"><span class="token-purple">tool</span><span class="token-muted">:</span> <span class="token-blue">apply_change</span><br/><span class="token-purple">ticket</span><span class="token-muted">:</span> <span class="token-green">"INC-001"</span></div><div class="art-node-bottom"><span class="tiny-square"></span>{zh ? '提出操作，等待确认' : 'Propose. Await approval.'}</div></div>
  <div class="runtime-orbit"><div class="orbit-ring orbit-ring-outer"></div><div class="orbit-ring orbit-ring-middle"></div><div class="orbit-satellite"></div><div class="runtime-core"><Logo compact/><span>DURABLE CORE</span></div><span class="orbit-coordinate">{zh ? '每一步，持久保存' : 'EVERY STEP, RECORDED'}</span></div>
  <div class="art-node art-node-output"><div class="art-node-label"><span class="node-icon"><Icon name="check" size={14}/></span> RESUME → CONTINUE <span class="node-small-dot"></span></div><div class="art-result"><span class="result-symbol"><Icon name="check" size={18}/></span><div><strong>{zh ? '从原任务，继续' : 'Same run. Next step.'}</strong><code>run_01J_RELF</code></div></div><div class="art-node-bottom"><span class="tiny-square"></span>{zh ? '审批记录已保存' : 'Approval record retained'}</div></div>
  <span class="art-corner art-corner-tl">FIG. 01 — EXECUTION CONTINUITY</span><span class="art-corner art-corner-br">DEFINE / EXECUTE / RECOVER</span>
</div>
