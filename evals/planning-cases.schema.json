{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen Ralf planning quality cases v1",
  "type": "object",
  "required": [
    "version",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "task",
        "context",
        "members",
        "oracle"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "context": {
          "type": "object"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/member"
          }
        },
        "oracle": {
          "$ref": "#/$defs/oracle"
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "input_schema"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "input_schema": {
          "type": [
            "object",
            "boolean"
          ]
        }
      }
    },
    "pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string"
      }
    },
    "oracle": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "plan",
            "refused",
            "needs_input"
          ]
        },
        "required_members": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "allowed_members": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "member_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "max_nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pair"
          }
        },
        "independent": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pair"
          }
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/expectation"
            }
          }
        },
        "output": {
          "$ref": "#/$defs/expectation"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "member",
              "source_member",
              "path",
              "equals",
              "negate"
            ],
            "properties": {
              "member": {
                "type": "string"
              },
              "source_member": {
                "type": "string"
              },
              "path": {
                "type": "array"
              },
              "equals": {},
              "negate": {
                "type": "boolean"
              }
            }
          }
        },
        "allow_skipped": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "plan"
              }
            }
          },
          "then": {
            "required": [
              "required_members",
              "allowed_members",
              "member_counts",
              "max_nodes",
              "dependencies",
              "independent",
              "arguments",
              "conditions",
              "output"
            ]
          }
        }
      ]
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "literal": {},
        "source_member": {
          "type": "string"
        },
        "source": {
          "const": "input"
        },
        "path": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "required": {
          "type": "boolean"
        },
        "default": {}
      },
      "oneOf": [
        {
          "required": [
            "literal"
          ]
        },
        {
          "required": [
            "source_member",
            "path"
          ]
        },
        {
          "required": [
            "source",
            "path"
          ]
        }
      ]
    }
  }
}
